{
  "name": "Hint Media Example",
  "ini": "Data\\SKSE\\Plugins\\dmenu\\customSettings\\ini\\HintMediaExample.ini",
  "data": [
    {
      "type": "group",
      "text": {
        "name": "Hint Media Examples",
        "desc": "Examples for description-only and flipbook tooltip media."
      },
      "entries": [
        {
          "type": "checkbox",
          "default": true,
          "ini": {
            "section": "HintExample",
            "id": "descOnly"
          },
          "text": {
            "name": "Desc Only",
            "desc": "This is the classic text-only tooltip. Percent test: 100% safe."
          }
        },
        {
          "type": "checkbox",
          "default": true,
          "ini": {
            "section": "HintExample",
            "id": "flipbookDemo"
          },
          "text": {
            "name": "Flipbook Demo",
            "desc": "Hover the control itself (showOn=control) to play a 3-frame flipbook."
          },
          "hint": {
            "showOn": "control",
            "media": {
              "type": "flipbook",
              "path": "Data\\SKSE\\Plugins\\dMenu\\hints\\ExampleFlipbook",
              "fps": 8,
              "maxW": 320,
              "maxH": 180,
              "loop": true,
              "preload": true,
              "cacheKey": "hint.flipbook.example"
            }
          }
        }
      ]
    }
  ]
